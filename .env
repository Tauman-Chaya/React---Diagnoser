# הגדרות ברירת מחדל של הקליינט (הקובץ הזה נמצא ב-git).
# לשינוי במחשב שלך בלבד: צרי קובץ .env.local עם אותם משתנים – הוא לא עולה ל-git וגובר על הקובץ הזה.
# אחרי שינוי מפעילים מחדש את npm start.

# כתובת השרת (C----Diagnoser)
REACT_APP_API_URL=https://localhost:7082

# המייל של המנהלת (ברירת מחדל כמו בשרת ובנתוני הדמה)
REACT_APP_MANAGER_EMAIL=esty@2024

# כלי בדיקת הסגנון (ESLint) של create-react-app לא עובד עם Node 24, ולכן הוא כבוי בזמן הרצה ובנייה
DISABLE_ESLINT_PLUGIN=true
